# Shell scripts - use LF
*.sh text eol=lf

# Batch files - use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code - use LF
*.java text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Config files - use LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.toml text eol=lf

# SQL files - use LF
*.sql text eol=lf

# Markdown and docs - use LF
*.md text eol=lf

# Git files - use LF
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary
